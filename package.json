{
  "name": "collection-js",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Monorepo for @anil-labs/collection-js — a fluent, Laravel-inspired Collection library for JavaScript and TypeScript",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "dev": "pnpm --filter example-playground dev",
    "test": "pnpm --filter \"./packages/*\" -r test",
    "test:coverage": "pnpm --filter @anil-labs/collection-js test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "example:playground": "pnpm --filter example-playground dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.13.0"
}
